---
/** 项目页：配置层规则在构建期结合数据层传入交互岛，路由负责开关与编排。 */
import ProjectSection from "@components/organisms/ProjectSection.svelte";
import I18nKey from "@i18n/i18nKey";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { resolveI18nText } from "@utils/i18n-utils";
import { projectsConfig } from "@/config/projectsConfig";
import { projectsSectionProps } from "@/utils/feature-sections";

if (!projectsConfig.enable) {
	return Astro.redirect("/404/");
}

const pageTitle = resolveI18nText(projectsConfig.title, I18nKey.projects);
const pageDescription = resolveI18nText(
	projectsConfig.description,
	I18nKey.projectsBanner,
);

const sectionProps = projectsSectionProps(projectsConfig);
---

<MainGridLayout
	title={pageTitle}
	description={pageDescription}
	page="projects"
>
	<editable-component
		data-component="projects-section"
		data-prop-items="@data[projects]"
		data-prop-settings="@data[projects_settings]"
	>
		<ProjectSection {...sectionProps} client:visible />
	</editable-component>
	<script>
		if (window.inEditorMode) {
			import("@/cloudcannon/register/projects").catch((error) => {
				console.warn("Failed to load CloudCannon component registration:", error);
			});
		}
	</script>
</MainGridLayout>
