---
import FriendSection from "@components/organisms/FriendSection.svelte";
import I18nKey from "@i18n/i18nKey";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { resolveI18nText } from "@utils/i18n-utils";
import { friendsConfig } from "@/config/friendsConfig";
import { friendsSectionProps } from "@/utils/feature-sections";

if (!friendsConfig.enable) {
	return Astro.redirect("/404/");
}

const pageTitle = resolveI18nText(friendsConfig.title, I18nKey.friends);
const pageDescription = resolveI18nText(
	friendsConfig.description,
	I18nKey.friendsBanner,
);

const sectionProps = friendsSectionProps(friendsConfig);
---

<MainGridLayout title={pageTitle} description={pageDescription} page="friends">
	<editable-component
		data-component="friends-section"
		data-prop-items="@data[friends]"
		data-prop-settings="@data[friends_settings]"
	>
		<FriendSection {...sectionProps} client:visible />
	</editable-component>
	<script>
		if (window.inEditorMode) {
			import("@/cloudcannon/register/friends").catch((error) => {
				console.warn("Failed to load CloudCannon component registration:", error);
			});
		}
	</script>
</MainGridLayout>
