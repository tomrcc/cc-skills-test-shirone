---
/**
 * 番剧收藏页：数据经 utils/anime-data（AnimeSource 分发，本地/快照/Dev热加载）
 * 构建期/Dev环境取得后交给客户端岛渲染（筛选/过渡/分页均为交互态）。
 */
import AnimeSection from "@components/organisms/AnimeSection.svelte";
import I18nKey from "@i18n/i18nKey";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { resolveI18nText } from "@utils/i18n-utils";
import { animeConfig, resolveAnimeOptions } from "@/config/animeConfig";
import { animeSectionProps } from "@/utils/feature-sections";
import { getAnimeList } from "../utils/anime-data";

if (!animeConfig.enable) {
	return Astro.redirect("/404/");
}

const pageTitle = resolveI18nText(animeConfig.title, I18nKey.anime);
const pageDescription = resolveI18nText(
	animeConfig.description,
	I18nKey.animeBanner,
);

// Only the local list has a data file for CloudCannon to edit; provider snapshots don't.
const fromDataFile = resolveAnimeOptions(animeConfig).source.kind === "local";
const sectionProps = animeSectionProps(
	animeConfig,
	await getAnimeList(),
	fromDataFile,
);
---

<MainGridLayout title={pageTitle} description={pageDescription} page="anime">
	{fromDataFile ? (
		<editable-component
			data-component="anime-section"
			data-prop-items="@data[anime]"
			data-prop-settings="@data[anime_settings]"
		>
			<AnimeSection {...sectionProps} client:visible />
		</editable-component>
	) : (
		<AnimeSection {...sectionProps} client:visible />
	)}
	<script>
		if (window.inEditorMode) {
			import("@/cloudcannon/register/anime").catch((error) => {
				console.warn("Failed to load CloudCannon component registration:", error);
			});
		}
	</script>
</MainGridLayout>
