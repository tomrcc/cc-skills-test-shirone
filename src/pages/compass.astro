---
/**
 * 站点罗盘页：常用站点按分组陈列（本地数据源，构建期取得后交给客户端岛渲染；
 * 搜索过滤 / 分组锚点滚动 / stagger 入场均为交互态）。
 */
import CompassSection from "@components/organisms/CompassSection.svelte";
import I18nKey from "@i18n/i18nKey";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { resolveI18nText } from "@utils/i18n-utils";
import { compassConfig } from "@/config/compassConfig";
import { compassSectionProps } from "@/utils/feature-sections";

if (!compassConfig.enable) {
	return Astro.redirect("/404/");
}

const pageTitle = resolveI18nText(compassConfig.title, I18nKey.compass);
const pageDescription = resolveI18nText(
	compassConfig.description,
	I18nKey.compassBanner,
);

const sectionProps = compassSectionProps(compassConfig);
---

<MainGridLayout title={pageTitle} description={pageDescription} page="compass">
	<editable-component
		data-component="compass-section"
		data-prop="@data[compass]"
	>
		<CompassSection {...sectionProps} client:visible />
	</editable-component>
	<script>
		if (window.inEditorMode) {
			import("@/cloudcannon/register/compass").catch((error) => {
				console.warn("Failed to load CloudCannon component registration:", error);
			});
		}
	</script>
</MainGridLayout>
