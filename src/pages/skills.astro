---
/** 技能页：配置层规则在构建期结合数据层传入交互岛，路由负责开关与编排。 */
import SkillSection from "@components/organisms/SkillSection.svelte";
import I18nKey from "@i18n/i18nKey";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { resolveI18nText } from "@utils/i18n-utils";
import { skillsConfig } from "@/config/skillsConfig";
import { skillsSectionProps } from "@/utils/feature-sections";

if (!skillsConfig.enable) {
	return Astro.redirect("/404/");
}

const pageTitle = resolveI18nText(skillsConfig.title, I18nKey.skills);
const pageDescription = resolveI18nText(
	skillsConfig.description,
	I18nKey.skillsBanner,
);

const sectionProps = skillsSectionProps(skillsConfig);
---

<MainGridLayout
	title={pageTitle}
	description={pageDescription}
	page="skills"
>
	<editable-component
		data-component="skills-section"
		data-prop="@data[skills]"
	>
		<SkillSection {...sectionProps} client:visible />
	</editable-component>
	<script>
		if (window.inEditorMode) {
			import("@/cloudcannon/register/skills").catch((error) => {
				console.warn("Failed to load CloudCannon component registration:", error);
			});
		}
	</script>
</MainGridLayout>
