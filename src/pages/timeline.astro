---
/** 时间线页：配置层规则在构建期结合数据层传入交互岛，路由负责开关与编排。 */
import TimelineSection from "@components/organisms/TimelineSection.svelte";
import I18nKey from "@i18n/i18nKey";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { resolveI18nText } from "@utils/i18n-utils";
import { timelineConfig } from "@/config/timelineConfig";
import { timelineSectionProps } from "@/utils/feature-sections";

if (!timelineConfig.enable) {
	return Astro.redirect("/404/");
}

const pageTitle = resolveI18nText(timelineConfig.title, I18nKey.timeline);
const pageDescription = resolveI18nText(
	timelineConfig.description,
	I18nKey.timelineBanner,
);

const sectionProps = timelineSectionProps(timelineConfig);
---

<MainGridLayout
	title={pageTitle}
	description={pageDescription}
	page="timeline"
>
	<editable-component
		data-component="timeline-section"
		data-prop="@data[timeline]"
	>
		<TimelineSection {...sectionProps} client:visible />
	</editable-component>
	<script>
		if (window.inEditorMode) {
			import("@/cloudcannon/register/timeline").catch((error) => {
				console.warn("Failed to load CloudCannon component registration:", error);
			});
		}
	</script>
</MainGridLayout>
